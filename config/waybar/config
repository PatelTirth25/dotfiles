
{
    "layer": "top",
    "position": "top",
    "height": 28,
    "spacing": 0,

    "modules-left": [
        "sway/workspaces"
    ],

    "modules-center": [],

    "modules-right": [
        "cpu",
        "custom/memory",
        "custom/wifi",
        "bluetooth",
        "backlight",
        "pulseaudio",
        "custom/battery",
        "custom/time",
        "custom/date"
    ],

    "sway/workspaces": {
        "disable-scroll": true,
        "sort-by-name": true,
        "format": " {name} ",
        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": [],
            "5": []
        },
        "on-click": "swaymsg workspace {name}"
    },

    "cpu": {
        "format": " {usage}% ",
        "max-length": 10,
        "interval": 5
    },

    "custom/memory": {
        "exec": "ram_usage",
        "interval": 5,
        "return-type": "text"
    },

    "custom/wifi": {
        "exec": "wifiName 2>/dev/null",
        "interval": 5,
        "on-click": "kitty wlctl",
        "return-type": "text"
    },

    "bluetooth": {
        "format": " {status}",
        "format-disabled": " off",
        "format-off": " off",
        "format-connected": " {device_alias}",
        "format-connected-battery": " {device_alias} {device_battery_percentage}%",
        "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%",
        "on-click": "kitty bluetui"
    },

    "backlight": {
        "device": "intel_backlight",
        "format": "{icon}",
        "format-icons": [
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            ""
        ]
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "",
        "format-icons": {
            "default": [
                "",
                "",
                ""
            ]
        },
        "on-click": "pavucontrol"
    },

    "custom/battery": {
        "exec": "battery",
        "interval": 5,
        "return-type": "text"
    },

    "custom/time": {
        "exec": "timeformat",
        "interval": 30,
        "return-type": "text"
    },

    "custom/date": {
        "exec": "dateformat",
        "interval": 60,
        "return-type": "text"
    }
}
