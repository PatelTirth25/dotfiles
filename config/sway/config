# Variables
set $mod Mod4
set $left h
set $down j
set $up k
set $right l

set $term kitty
set $menu /home/tirth/.config/rofi/launchers/type-4/launcher.sh
set $file nemo
set $browser zen-beta

# Outputs
# Laptop display on the left
output eDP-1 mode 1920x1200@59.999Hz
output eDP-1 pos 0 0

# Acer B277U on the right: 1440p @ 120Hz with VRR
output DP-2 mode 2560x1440@119.998Hz
output DP-2 adaptive_sync on
output DP-2 pos 1920 0

# Startup
exec --no-startup-id /home/tirth/.local/bin/startup
exec_always --no-startup-id autotiling
exec --no-startup-id /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1

# Input
input "type:keyboard" {
    xkb_options "caps:swapescape"
}

# Disable keyboard remapping for Corne36
input "65261:22136:Tirth_Corne36_RP2040_Single" {
    xkb_options ""
}

input "type:touchpad" {
    tap enabled
    natural_scroll enabled
}

# Applications
bindsym $mod+Return exec $term
bindsym $mod+b exec $browser
bindsym $mod+n exec $file
bindsym $mod+Space exec $menu
bindsym Print exec ~/.local/bin/screenshot

# Window management
bindsym $mod+y kill
floating_modifier $mod normal

bindsym $mod+g exec "swaymsg reload && ~/.local/bin/startup"
bindsym $mod+Shift+q exec swaymsg exit
bindsym $mod+q exec swaylock-plugin --command 'mpvpaper -o "no-audio --loop-file=inf --vf=fps=30 --panscan=1.0" "*" "$HOME/pix/live-wallpaper/frieren.mp4"'

bindsym $mod+Shift+BackSpace exec "shutdown now"
bindsym $mod+Shift+Delete exec "reboot"

# Audio
bindsym XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle

# Brightness
bindsym XF86MonBrightnessUp exec brightnessctl set +5%
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-

# Workspace navigation
bindsym $mod+6 workspace 1
bindsym $mod+7 workspace 2
bindsym $mod+8 workspace 3
bindsym $mod+9 workspace 4
bindsym $mod+0 workspace 5

bindsym $mod+Shift+6 move container to workspace 1
bindsym $mod+Shift+7 move container to workspace 2
bindsym $mod+Shift+8 move container to workspace 3
bindsym $mod+Shift+9 move container to workspace 4
bindsym $mod+Shift+0 move container to workspace 5

# Laptop display workspace
workspace 6 output eDP-1
bindsym $mod+grave workspace 6

# Assign workspaces 1-5 to external monitor
workspace 1 output DP-2
workspace 2 output DP-2
workspace 3 output DP-2
workspace 4 output DP-2
workspace 5 output DP-2

# Focus between tiled windows
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right

# Move focused containers
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right

# Arrow-key container movement
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Layout
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+f fullscreen
bindsym $mod+Shift+space floating toggle

# Resize containers and floating windows
bindsym $mod+Ctrl+$left resize shrink width 10 px
bindsym $mod+Ctrl+$down resize grow height 10 px
bindsym $mod+Ctrl+$up resize shrink height 10 px
bindsym $mod+Ctrl+$right resize grow width 10 px

# Arrow-key resizing
bindsym $mod+Right resize grow width 10 px
bindsym $mod+Left resize shrink width 10 px
bindsym $mod+Up resize shrink height 10 px
bindsym $mod+Down resize grow height 10 px

# Workspace gestures
bindgesture swipe:right workspace prev
bindgesture swipe:left workspace next

# Appearance
gaps inner 3
gaps outer 3

default_border pixel 1
default_floating_border pixel 1

client.focused "#c678dd" "#c678dd" "#c678dd" "#c678dd"

# Floating utility windows
for_window [app_id="kitty" title="bluetui"] floating enable, resize set width 50 ppt height 50 ppt, move position center
for_window [app_id="kitty" title="wlctl"] floating enable, resize set width 50 ppt height 50 ppt, move position center
for_window [app_id="pavucontrol"] floating enable, resize set width 50 ppt height 50 ppt, move position center

include /etc/sway/config.d/*.conf
