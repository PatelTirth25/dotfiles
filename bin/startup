#!/bin/sh

# Set up PATH
export PATH="$HOME/.local/bin:$PATH"

# Kill existing instances to prevent duplicates
pkill waybar 2>/dev/null
pkill gammastep 2>/dev/null
pkill -f "wallpaper" 2>/dev/null

# Start Waybar
setsid waybar \
    -c "$HOME/.config/waybar/config" \
    -s "$HOME/.config/waybar/style.css" &

# Start other services
setsid "$HOME/.local/bin/wallpaper" &
setsid gammastep -c "$HOME/.config/gammastep/config.ini" &
