#!/usr/bin/env bash
set -euo pipefail

PACTL="$(command -v pactl)"

LAPTOP="alsa_output.pci-0000_00_1f.3.pro-output-0"
MONITOR="alsa_output.pci-0000_00_1f.3.pro-output-3"
COMBINED="combined_output"

# Wait for both physical sinks to become available.
READY=0
for _ in $(seq 1 30); do
    if "$PACTL" list short sinks | grep -q "$LAPTOP" &&
       "$PACTL" list short sinks | grep -q "$MONITOR"; then
        READY=1
        break
    fi
    sleep 1
done

if [ "$READY" -ne 1 ]; then
    echo "Error: laptop or monitor audio sink not available." >&2
    exit 1
fi

# Create the combined sink only if it doesn't already exist.
if ! "$PACTL" list short sinks | grep -q "$COMBINED"; then
    "$PACTL" load-module module-combine-sink \
        "sink_name=$COMBINED" \
        "slaves=$LAPTOP,$MONITOR" \
        "sink_properties=device.description=Combined_Output"
fi

# Set individual output volumes and default sink.
"$PACTL" set-sink-volume "$LAPTOP" 100%
"$PACTL" set-sink-volume "$MONITOR" 80%
"$PACTL" set-default-sink "$COMBINED"
