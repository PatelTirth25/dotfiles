#!/usr/bin/env bash
set -e

echo "=== Cleaning npm ==="

npm cache clean --force 2>/dev/null || true
rm -rf ~/.npm/_npx
rm -rf ~/.npm/_logs
rm -rf node_modules/.cache 2>/dev/null || true


echo "=== Cleaning pnpm ==="

pnpm store prune 2>/dev/null || true


echo "=== Cleaning yarn ==="

yarn cache clean --all 2>/dev/null || true


echo "=== Cleaning Cargo ==="

# Remove downloaded registry/git sources that are not currently needed
rm -rf ~/.cargo/registry
rm -rf ~/.cargo/git


echo "=== Cleaning Nix generations ==="

# Remove old user-profile generations
nix profile wipe-history --older-than 30d 2>/dev/null || true

# Remove old NixOS generations
sudo nix-collect-garbage --delete-older-than 30d


echo "=== Optimizing Nix store ==="

sudo nix-store --optimise


echo "=== Cleaning journal logs ==="

sudo journalctl --vacuum-time=30d


echo "=== Cleaning Docker ==="

# WARNING:
# This removes unused images/containers/networks/volumes.
# Remove this section if you want to preserve unused Docker volumes.
sudo docker system prune -af --volumes 2>/dev/null || true


echo "=== Cleaning Trash ==="

rm -rf ~/.local/share/Trash/files/*
rm -rf ~/.local/share/Trash/info/*


echo "=== Cleanup complete ==="
