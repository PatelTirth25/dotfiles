#!/bin/sh

case $BLOCK_BUTTON in
    1) setsid -w -f "$TERMINAL" -e pulsemixer; pkill -RTMIN+10 "${STATUSBAR:-dwmblocks}" ;;
    2) wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
    4) wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%+ ;;
    5) wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%- ;;
    3) notify-send "󰕾 Volume" "- Middle click: mute\n- Scroll: change volume" ;;
    6) setsid -f "$TERMINAL" -e "$EDITOR" "$0" ;;
esac

# wpctl get-volume outputs "Volume: 0.45" or "Volume: 0.45 [MUTED]"
wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{
    vol = int($2 * 100)
    
    if ($3 == "[MUTED]") {
        print "󰖁 " vol "%"
    } else {
        if (vol >= 70)      print "󰕾 " vol "%"
        else if (vol >= 30) print "󰖀 " vol "%"
        else if (vol > 0)   print "󰕿 " vol "%"
        else                print "󰖁 " vol "%"
    }
}'
